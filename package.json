{
  "name": "goacadio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy": "wrangler deploy",
    "preview": "npm run build && vite preview",
    "typecheck": "react-router typegen && tsc --noEmit",
    "cf-typegen": "wrangler types && react-router typegen",
    "check:release": "node scripts/check-release.mjs",
    "check:prelaunch": "npm run check:launch",
    "check:live": "node scripts/check-live.mjs",
    "prepare:sitemap": "node scripts/generate-sitemap-template.mjs",
    "test:data-export": "node scripts/test-account-export.mjs",
    "test:v36": "node scripts/test-v36.mjs",
    "test:v37": "node scripts/test-v37.mjs",
    "check:live:json": "node scripts/check-live.mjs --json",
    "audit:links": "node scripts/audit-site-links.mjs",
    "prepare:seo-candidate": "node scripts/prepare-launch-candidate.mjs",
    "test:v38": "node scripts/test-v38.mjs",
    "test:contact": "node scripts/test-public-contact.mjs",
    "test:v39": "node scripts/test-v39.mjs",
    "check:ci": "npm run check:launch && npm run audit:links && npm run test:v36 && npm run test:v37 && npm run test:v38 && npm run test:data-export && npm run test:contact && npm run test:v39 && npm run test:functional && npm run typecheck && npm run build",
    "test:functional": "node scripts/test-v40.mjs",
    "check:api-guest": "node scripts/check-api-guest.mjs",
    "check:api-guest:json": "node scripts/check-api-guest.mjs --json",
    "check:launch": "npm run check:release && node scripts/check-prelaunch.mjs && node scripts/test-v41.mjs",
    "test:v41": "node scripts/test-v41.mjs"
  },
  "dependencies": {
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.9.6",
    "@supabase/supabase-js": "^2.49.0",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.15.3",
    "@react-router/dev": "7.9.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.88.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
